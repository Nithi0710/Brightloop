# ==============================================
# BRIGHTLOOP SUBSCRIPTION MANAGEMENT SYSTEM (.env)
# ==============================================

# Application URL
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="brightloop-super-secret-jwt-key-minimum-32-chars-long-123456"

# Database Configuration (Supabase PostgreSQL)
# Connection pooling URL (for application queries)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection URL (for migrations and Prisma CLI)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase Storage & Client API
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."
SUPABASE_STORAGE_BUCKET="brightloop-assets"

# Email Configuration (Nodemailer / SMTP)
EMAIL_SERVER_HOST="smtp.resend.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="resend"
EMAIL_SERVER_PASSWORD="re_..."
EMAIL_FROM="Brightloop Software <billing@brightloop.io>"

# Cron / Webhook Security Secret for Automated Billing Route
CRON_SECRET="brightloop-cron-authorization-secret-token"

# Optional App Config
NEXT_PUBLIC_COMPANY_NAME="Brightloop Software Inc."
NEXT_PUBLIC_COMPANY_ADDRESS="100 Innovation Way, Suite 400, Tech City, CA 94105"
NEXT_PUBLIC_COMPANY_EMAIL="support@brightloop.io"
NEXT_PUBLIC_COMPANY_PHONE="+1 (800) 555-0199"
NEXT_PUBLIC_CURRENCY_SYMBOL="$"

