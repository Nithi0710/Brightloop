// Brightloop Subscription Management System
// Prisma Schema - PostgreSQL (Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// AUTHENTICATION MODELS (NextAuth.js compatible)
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(CUSTOMER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts             Account[]
  sessions             Session[]
  passwordResetTokens  PasswordResetToken[]
  customer             Customer?
  staffManagedBy       User?           @relation("StaffManager", fields: [managedById], references: [id])
  managedById          String?
  staff                User[]          @relation("StaffManager")
  notifications        Notification[]
  auditLogs            AuditLog[]
  paymentsRecorded     Payment[]       @relation("PaymentRecorder")

  @@index([email])
  @@map("users")
}

enum UserRole {
  ADMIN
  STAFF
  CUSTOMER
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("password_reset_tokens")
}

// ============================================================
// CUSTOMER MODEL
// ============================================================

model Customer {
  id             String    @id @default(cuid())
  customerId     String    @unique @default(cuid())
  userId         String?   @unique
  name           String
  email          String    @unique
  phone          String?
  businessName   String?
  billingAddress String?
  city           String?
  state          String?
  country        String?
  postalCode     String?
  taxId          String?
  status         CustomerStatus @default(ACTIVE)
  notes          String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  user           User?           @relation(fields: [userId], references: [id])
  quotations     Quotation[]
  subscriptions  Subscription[]
  invoices       Invoice[]
  payments       Payment[]
  discountUsages DiscountUsage[]

  @@index([email])
  @@index([status])
  @@map("customers")
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// ============================================================
// PRODUCT MANAGEMENT
// ============================================================

model Product {
  id           String        @id @default(cuid())
  name         String
  type         ProductType
  salesPrice   Decimal       @db.Decimal(12, 2)
  costPrice    Decimal?      @db.Decimal(12, 2)
  description  String?       @db.Text
  internalNotes String?      @db.Text
  imageUrl     String?
  status       ProductStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  variants         ProductVariant[]
  plans            Plan[]
  quotationLines   QuotationLine[]
  subscriptionLines SubscriptionLine[]
  invoiceLines     InvoiceLine[]
  taxes            ProductTax[]
  discounts        DiscountProduct[]
  planProducts     PlanProduct[]

  @@map("products")
}

enum ProductType {
  SOFTWARE
  SERVICE
  ADDON
  HARDWARE
  CONSULTING
  OTHER
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model ProductVariant {
  id           String   @id @default(cuid())
  productId    String
  name         String
  priceAdjustment Decimal @db.Decimal(12, 2) @default(0)
  description  String?
  status       VariantStatus @default(ACTIVE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product          Product           @relation(fields: [productId], references: [id])
  quotationLines   QuotationLine[]
  subscriptionLines SubscriptionLine[]
  invoiceLines     InvoiceLine[]

  @@map("product_variants")
}

enum VariantStatus {
  ACTIVE
  INACTIVE
}

// ============================================================
// TAX MANAGEMENT
// ============================================================

model Tax {
  id          String    @id @default(cuid())
  name        String
  rate        Decimal   @db.Decimal(5, 4) // e.g., 0.18 for 18%
  type        TaxType   @default(PERCENTAGE)
  description String?
  isDefault   Boolean   @default(false)
  status      TaxStatus @default(ACTIVE)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products     ProductTax[]
  invoiceLines InvoiceLine[]

  @@map("taxes")
}

enum TaxType {
  PERCENTAGE
  FIXED
}

enum TaxStatus {
  ACTIVE
  INACTIVE
}

model ProductTax {
  id        String   @id @default(cuid())
  productId String
  taxId     String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  tax     Tax     @relation(fields: [taxId], references: [id])

  @@unique([productId, taxId])
  @@map("product_taxes")
}

// ============================================================
// DISCOUNT MANAGEMENT
// ============================================================

model Discount {
  id              String       @id @default(cuid())
  name            String
  code            String?      @unique
  type            DiscountType
  value           Decimal      @db.Decimal(12, 2)
  minPurchase     Decimal?     @db.Decimal(12, 2)
  minQuantity     Int?
  startDate       DateTime?
  endDate         DateTime?
  maxUsageCount   Int?
  currentUsage    Int          @default(0)
  status          DiscountStatus @default(ACTIVE)
  description     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  products       DiscountProduct[]
  usages         DiscountUsage[]
  quotationLines QuotationLine[]
  invoiceLines   InvoiceLine[]

  @@map("discounts")
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum DiscountStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

model DiscountProduct {
  id         String   @id @default(cuid())
  discountId String
  productId  String
  createdAt  DateTime @default(now())

  discount Discount @relation(fields: [discountId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([discountId, productId])
  @@map("discount_products")
}

model DiscountUsage {
  id           String   @id @default(cuid())
  discountId   String
  customerId   String
  invoiceId    String?
  quotationId  String?
  amountSaved  Decimal  @db.Decimal(12, 2)
  usedAt       DateTime @default(now())

  discount  Discount  @relation(fields: [discountId], references: [id])
  customer  Customer  @relation(fields: [customerId], references: [id])
  invoice   Invoice?  @relation(fields: [invoiceId], references: [id])
  quotation Quotation? @relation(fields: [quotationId], references: [id])

  @@map("discount_usages")
}

// ============================================================
// PLAN MANAGEMENT
// ============================================================

model Plan {
  id                String    @id @default(cuid())
  name              String
  productId         String?
  description       String?   @db.Text
  billingFrequency  BillingFrequency
  billingPrice      Decimal   @db.Decimal(12, 2)
  minQuantity       Int       @default(1)
  availableFrom     DateTime?
  availableUntil    DateTime?
  autoClose         Boolean   @default(false)
  allowEarlyClosure Boolean   @default(true)
  allowPause        Boolean   @default(true)
  allowRenewal      Boolean   @default(true)
  status            PlanStatus @default(ACTIVE)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  product        Product?         @relation(fields: [productId], references: [id])
  subscriptions  Subscription[]
  planProducts   PlanProduct[]
  quotations     Quotation[]
  templates      QuotationTemplate[]

  @@map("plans")
}

enum BillingFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum PlanStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model PlanProduct {
  id        String   @id @default(cuid())
  planId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  plan    Plan    @relation(fields: [planId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([planId, productId])
  @@map("plan_products")
}

// ============================================================
// QUOTATION TEMPLATE
// ============================================================

model QuotationTemplate {
  id               String   @id @default(cuid())
  name             String
  description      String?  @db.Text
  defaultPlanId    String?
  validityDays     Int      @default(30)
  termsAndConditions String? @db.Text
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  defaultPlan Plan?                    @relation(fields: [defaultPlanId], references: [id])
  lines       QuotationTemplateLine[]
  quotations  Quotation[]

  @@map("quotation_templates")
}

model QuotationTemplateLine {
  id           String   @id @default(cuid())
  templateId   String
  productId    String?
  description  String?
  quantity     Decimal  @db.Decimal(10, 2) @default(1)
  unitPrice    Decimal  @db.Decimal(12, 2)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  template QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("quotation_template_lines")
}

// ============================================================
// QUOTATION
// ============================================================

model Quotation {
  id              String          @id @default(cuid())
  quotationNumber String          @unique
  customerId      String
  planId          String?
  templateId      String?
  title           String?
  description     String?         @db.Text
  status          QuotationStatus @default(DRAFT)
  validUntil      DateTime?
  subtotal        Decimal         @db.Decimal(12, 2) @default(0)
  discountAmount  Decimal         @db.Decimal(12, 2) @default(0)
  taxAmount       Decimal         @db.Decimal(12, 2) @default(0)
  total           Decimal         @db.Decimal(12, 2) @default(0)
  termsAndConditions String?      @db.Text
  notes           String?         @db.Text
  sentAt          DateTime?
  confirmedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  customer       Customer           @relation(fields: [customerId], references: [id])
  plan           Plan?              @relation(fields: [planId], references: [id])
  template       QuotationTemplate? @relation(fields: [templateId], references: [id])
  lines          QuotationLine[]
  subscriptions  Subscription[]
  discountUsages DiscountUsage[]

  @@index([quotationNumber])
  @@index([customerId])
  @@index([status])
  @@map("quotations")
}

enum QuotationStatus {
  DRAFT
  SENT
  CONFIRMED
  EXPIRED
  CONVERTED
  CANCELLED
}

model QuotationLine {
  id              String   @id @default(cuid())
  quotationId     String
  productId       String?
  variantId       String?
  discountId      String?
  description     String
  quantity        Decimal  @db.Decimal(10, 2)
  unitPrice       Decimal  @db.Decimal(12, 2)
  variantPrice    Decimal  @db.Decimal(12, 2) @default(0)
  discountAmount  Decimal  @db.Decimal(12, 2) @default(0)
  discountType    DiscountType?
  discountValue   Decimal? @db.Decimal(12, 2)
  taxRate         Decimal  @db.Decimal(5, 4) @default(0)
  taxAmount       Decimal  @db.Decimal(12, 2) @default(0)
  subtotal        Decimal  @db.Decimal(12, 2)
  total           Decimal  @db.Decimal(12, 2)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  quotation Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product?        @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  discount  Discount?       @relation(fields: [discountId], references: [id])

  @@map("quotation_lines")
}

// ============================================================
// SUBSCRIPTION
// ============================================================

model Subscription {
  id                 String             @id @default(cuid())
  subscriptionNumber String             @unique
  customerId         String
  planId             String
  quotationId        String?
  status             SubscriptionStatus @default(DRAFT)
  startDate          DateTime
  endDate            DateTime?
  billingFrequency   BillingFrequency
  nextBillingDate    DateTime?
  paymentTerms       Int                @default(30) // days
  subtotal           Decimal            @db.Decimal(12, 2) @default(0)
  discountAmount     Decimal            @db.Decimal(12, 2) @default(0)
  taxAmount          Decimal            @db.Decimal(12, 2) @default(0)
  total              Decimal            @db.Decimal(12, 2) @default(0)
  notes              String?            @db.Text
  confirmedAt        DateTime?
  activatedAt        DateTime?
  pausedAt           DateTime?
  closedAt           DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  customer Customer          @relation(fields: [customerId], references: [id])
  plan     Plan              @relation(fields: [planId], references: [id])
  quotation Quotation?       @relation(fields: [quotationId], references: [id])
  lines    SubscriptionLine[]
  invoices Invoice[]
  events   SubscriptionEvent[]
  billingAttempts BillingAttempt[]

  @@index([subscriptionNumber])
  @@index([status])
  @@index([nextBillingDate])
  @@index([customerId])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}

model SubscriptionLine {
  id           String   @id @default(cuid())
  subscriptionId String
  productId    String?
  variantId    String?
  description  String
  quantity     Decimal  @db.Decimal(10, 2)
  unitPrice    Decimal  @db.Decimal(12, 2)  // Snapshot at time of creation
  variantPrice Decimal  @db.Decimal(12, 2) @default(0)
  discountAmount Decimal @db.Decimal(12, 2) @default(0)
  taxRate      Decimal  @db.Decimal(5, 4) @default(0)
  taxAmount    Decimal  @db.Decimal(12, 2) @default(0)
  subtotal     Decimal  @db.Decimal(12, 2)
  total        Decimal  @db.Decimal(12, 2)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  subscription Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product      Product?       @relation(fields: [productId], references: [id])
  variant      ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("subscription_lines")
}

model SubscriptionEvent {
  id             String    @id @default(cuid())
  subscriptionId String
  eventType      String    // CREATED, CONFIRMED, ACTIVATED, PAUSED, RESUMED, CLOSED, RENEWED, etc.
  fromStatus     String?
  toStatus       String?
  description    String?
  performedById  String?
  metadata       Json?
  createdAt      DateTime  @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("subscription_events")
}

// ============================================================
// INVOICE
// ============================================================

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  customerId      String
  subscriptionId  String?
  status          InvoiceStatus @default(DRAFT)
  invoiceDate     DateTime
  dueDate         DateTime
  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?
  subtotal        Decimal       @db.Decimal(12, 2) @default(0)
  discountAmount  Decimal       @db.Decimal(12, 2) @default(0)
  taxAmount       Decimal       @db.Decimal(12, 2) @default(0)
  total           Decimal       @db.Decimal(12, 2) @default(0)
  paidAmount      Decimal       @db.Decimal(12, 2) @default(0)
  outstandingAmount Decimal     @db.Decimal(12, 2) @default(0)
  notes           String?       @db.Text
  sentAt          DateTime?
  confirmedAt     DateTime?
  paidAt          DateTime?
  cancelledAt     DateTime?
  idempotencyKey  String?       @unique // For billing engine dedup
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer       Customer        @relation(fields: [customerId], references: [id])
  subscription   Subscription?   @relation(fields: [subscriptionId], references: [id])
  lines          InvoiceLine[]
  payments       PaymentAllocation[]
  discountUsages DiscountUsage[]

  @@index([invoiceNumber])
  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@index([subscriptionId])
  @@map("invoices")
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  PARTIALLY_PAID
  CANCELLED
}

model InvoiceLine {
  id              String   @id @default(cuid())
  invoiceId       String
  productId       String?
  variantId       String?
  discountId      String?
  taxId           String?
  description     String
  quantity        Decimal  @db.Decimal(10, 2)
  unitPrice       Decimal  @db.Decimal(12, 2)  // Snapshot
  variantPrice    Decimal  @db.Decimal(12, 2) @default(0)
  discountAmount  Decimal  @db.Decimal(12, 2) @default(0)
  discountType    DiscountType?
  discountValue   Decimal? @db.Decimal(12, 2)
  taxName         String?  // Snapshot
  taxRate         Decimal  @db.Decimal(5, 4) @default(0)  // Snapshot
  taxAmount       Decimal  @db.Decimal(12, 2) @default(0)
  subtotal        Decimal  @db.Decimal(12, 2)
  total           Decimal  @db.Decimal(12, 2)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  invoice Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])
  discount Discount?      @relation(fields: [discountId], references: [id])
  tax     Tax?            @relation(fields: [taxId], references: [id])

  @@map("invoice_lines")
}

// ============================================================
// PAYMENT
// ============================================================

model Payment {
  id              String        @id @default(cuid())
  paymentReference String       @unique
  customerId      String
  paymentMethod   PaymentMethod
  amount          Decimal       @db.Decimal(12, 2)
  paymentDate     DateTime
  notes           String?       @db.Text
  recordedById    String
  status          PaymentStatus @default(COMPLETED)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer    Customer            @relation(fields: [customerId], references: [id])
  recordedBy  User                @relation("PaymentRecorder", fields: [recordedById], references: [id])
  allocations PaymentAllocation[]

  @@index([paymentReference])
  @@index([customerId])
  @@index([paymentDate])
  @@map("payments")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  UPI
  CHEQUE
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model PaymentAllocation {
  id        String   @id @default(cuid())
  paymentId String
  invoiceId String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@map("payment_allocations")
}

// ============================================================
// BILLING ENGINE
// ============================================================

model BillingAttempt {
  id             String              @id @default(cuid())
  subscriptionId String
  invoiceId      String?
  status         BillingAttemptStatus
  attemptedAt    DateTime            @default(now())
  errorMessage   String?             @db.Text
  metadata       Json?

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
  @@map("billing_attempts")
}

enum BillingAttemptStatus {
  SUCCESS
  FAILED
  SKIPPED
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String           @db.Text
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  BILLING
  PAYMENT
  SUBSCRIPTION
  INVOICE
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  action       String
  resource     String
  resourceId   String?
  description  String   @db.Text
  ipAddress    String?
  userAgent    String?
  oldValues    Json?
  newValues    Json?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

